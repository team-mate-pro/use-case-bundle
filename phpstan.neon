parameters:
    level: max
    paths:
        - src
        - tests

    excludePaths:
        - tests/_Data
        - vendor

    ignoreErrors:
        # PHPUnit data providers cannot bind a generic Result<T> at the source
        # of the dataset, so the test method signature has to stay un-parameterized.
        - '#Method .+Test::testHasContent\(\) has parameter \$sut with generic class .+Result but does not specify its types#'

    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkUninitializedProperties: true
    checkDynamicProperties: true
    treatPhpDocTypesAsCertain: false
